---
import { ProjectList } from "../components/miscellaneous/project-list";
import Layout from "../layouts/Layout.astro";
import { type ProjectInfo } from "../models/project.model";

const pageTitle = "Miscellaneous";

const projects: ProjectInfo[] = [
  {
    name: "Hwn Hwn",
    description:
      "Hwn Hwn is a project that i started for fun because my friend sent me some stickers. I wanted to find a way to make them appealing.",
    link: "https://hwnhwn.shibuicat.com",
  },
  {
    name: "Shibuicat",
    description:
      "It's this website you're currently on! A personal project to showcase my work and thoughts.",
    link: "https://shibuicat.com",
  },
  {
    name: "Shibui Blog",
    description:
      "A blog where I share my thoughts, ideas, and projects. It's a place for me to write about things that interest me and to connect with others.",
    link: "https://blog.shibuicat.com",
  },
];
---

<Layout pageTitle={pageTitle}>
  <div>
    <h1>Miscellaneous</h1>
    <p>
      This is a collection of random thoughts, ideas, and projects that don't
      fit into any specific category. It's a place for me to share my
      experimentation and exploration of different topics.
    </p>
    <p>I hope you find something interesting or inspiring here!</p>

    <br />

    <ProjectList projects={projects} />
  </div>
</Layout>
